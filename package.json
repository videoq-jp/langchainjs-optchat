{
  "name": "langchain-optchat",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/library-index.d.ts",
      "import": "./dist/library-index.js"
    },
    "./core": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "import": "./dist/langchain/index.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph/index.d.ts",
      "import": "./dist/langgraph/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "tsx --import ./test/support.ts --test test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.1",
    "@types/node": "^22.20.5",
    "langchain": "^1.6.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@langchain/core": "^1.5.1",
    "zod": "^4.6.7",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "langchain": "^1.6.8"
  },
  "description": "OptChat summary-tree conversation memory for LangChain.js and LangGraph.js.",
  "keywords": [
    "langchain",
    "langgraph",
    "optchat",
    "chat-history",
    "conversation-memory",
    "summary-tree"
  ],
  "author": "Jonas",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "docs/langchain*.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "langchain": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiharada1228/langchain-optchat.git"
  },
  "homepage": "https://github.com/yukiharada1228/langchain-optchat#readme",
  "bugs": {
    "url": "https://github.com/yukiharada1228/langchain-optchat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
